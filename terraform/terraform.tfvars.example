# Copy to terraform.tfvars (git-ignored) and edit. Placeholders only - never commit real values.
student_name         = "Your Name"
bastion_allowed_cidr = "203.0.113.25/32" # REPLACE with your current public IPv4 /32 (never 0.0.0.0/0)
aws_region           = "us-east-1"
aws_profile          = null              # or a named AWS CLI profile, e.g. "ewb-lab"
instance_type        = "t3.micro"
public_key_path      = "~/.ssh/ewb-lab.pub" # public key only; private key stays outside the repo
enable_peering       = true
# enable_app_b_ssh_from_app_a_test = false  # test-only; see variables.tf before enabling
